CC := gcc
flags := -Wall -g

dungeonmaster: main.o roomManip.o stringManip.o
	$(CC) $(flags) -o dungeonmaster main.o roomManip.o stringManip.o

main.o: main.c roomManip.h stringManip.h
	$(CC) $(flags) -c main.c

roomManip.o: roomManip.c roomManip.h stringManip.h
	$(CC) $(flags) -c roomManip.c

stringManip.o: stringManip.c stringManip.h
	$(CC) $(flags) -c stringManip.c

clean:
	rm *.o dungeonmaster